# chedck — In-House Check Printing System .gitignore

# ---------------------------------------------------------------------------
# Databases & Ledgers (contain live financial & check records — NEVER COMMIT)
# ---------------------------------------------------------------------------
db/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Security & Credentials (encrypted signature vault, keys, environment configs)
# ---------------------------------------------------------------------------
vault/
*.svlt
*.key
*.pem
*.pfx
*.cert
*.crt
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# PDF Output & Generated Statements
# ---------------------------------------------------------------------------
output/

# ---------------------------------------------------------------------------
# Test Artifacts, Local Renders & Visual Inspections
# ---------------------------------------------------------------------------
scratch/
test_*.pdf
test_*.png
*preview*.png
*reference*.png
*reference*.jpg
*crop*.png
logo_measured.png
current_header_crop.png

# ---------------------------------------------------------------------------
# Frontend (React / Vite)
# ---------------------------------------------------------------------------
node_modules/
ui/node_modules/
ui/dist/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# ---------------------------------------------------------------------------
# IDE & System Files
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.tmp

# Operating System Files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
