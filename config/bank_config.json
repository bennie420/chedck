{
  "_comment": "Bank MICR field configuration per Bank of America Global Account Printing Specifications and ANSI ASC X9.100-160-1 / ANSI X9.27.",

  "bank_name": "Bank of America, N.A.",
  "bank_city_state": "Dallas, TX",

  "micr_fields": {
    "_comment_positions": "Positions 1-65, position 1 = leading/right edge per Bank of America specs.",
    "amount_field":          { "start": 1,  "end": 12 },
    "amount_separator":      { "position": 13 },
    "on_us_field":           { "start": 14, "end": 31 },
    "on_us_separator":       { "position": 32 },
    "routing_field":         { "start": 33, "end": 43 },
    "epc_field":             { "position": 44, "use": false, "value": "" },
    "auxiliary_on_us":       {
      "start": 45, "end": 65,
      "_bofa_spec": "Auxiliary On-Us: Serial number 5 to 10 digits enclosed tightly with On-Us symbols with no blank spaces.",
      "tight_delimiters": true,
      "zero_pad": 5
    }
  },

  "positive_pay": {
    "format": "csv",
    "fields_order": ["account_number", "check_number", "issue_date", "amount", "payee_name", "void_flag"],
    "date_format": "%m/%d/%Y",
    "amount_format": "dollars_and_cents"
  },

  "reconciliation": {
    "format": "csv",
    "csv_columns": {
      "serial":        "CheckNumber",
      "cleared_date":  "PostDate",
      "amount":        "Amount",
      "payee":         "Description"
    }
  }
}
